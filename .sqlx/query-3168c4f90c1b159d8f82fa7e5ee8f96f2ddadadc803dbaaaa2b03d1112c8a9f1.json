  "db_name": "PostgreSQL",
  "query": "\n        select s.id, s.slug, s.situacao, s.provisorio_definitivo,\n               s.perfil as \"perfil: Json<PerfilDoSite>\",\n               (select d.host from dominio d where d.site_id = s.id and d.situacao = 'ativo') as dominio_ativo\n        from site s\n        where s.slug = $1\n        ",
