{
  "db_name": "PostgreSQL",
  "query": "\n        select s.id, s.slug, s.situacao, s.provisorio_definitivo,\n               s.perfil as \"perfil: Json<PerfilDoSite>\",\n               d.host as dominio_ativo\n        from dominio d\n        join site s on s.id = d.site_id\n        where d.host = $1 and d.situacao = 'ativo'\n        ",
