  "query": "\n        select s.id, s.slug, coalesce(s.perfil ->> 'nome', '') as \"nome!\", s.situacao, p.papel\n        from participacao p\n        join site s on s.id = p.site_id\n        where p.conta = $1\n        order by 3, s.slug\n        ",
