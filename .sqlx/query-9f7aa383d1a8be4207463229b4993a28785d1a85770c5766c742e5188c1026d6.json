  "query": "\n        select id as documento_id, site_id, agendado_para as \"agendado_para!\",\n               coalesce(agendado_por, '') as \"agendado_por!\"\n        from documento\n        where agendado_para is not null and agendado_para <= now()\n        order by agendado_para\n        limit 50\n        ",
