{
  "db_name": "PostgreSQL",
  "query": "\n        select s.id, s.slug, coalesce(s.perfil ->> 'nome', '') as \"nome!\", s.situacao,\n               coalesce(p.papel, 'dono') as \"papel!\"\n        from site s\n        left join participacao p on p.site_id = s.id and p.conta = $1\n        where p.conta is not null or $2\n        order by 3, s.slug\n        ",
