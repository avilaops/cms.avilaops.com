# Copie para `.env`. O `.env` não é versionado.

# Banco. As consultas são conferidas contra ele na compilação; sem banco à
# mão, use SQLX_OFFLINE=true, que lê o diretório `.sqlx`.
DATABASE_URL=postgres://postgres@127.0.0.1:5549/cms_dev

# Porta em que o servidor escuta.
PORTA=3090

# Todo site nasce em <slug>.<DOMINIO_BASE>.
DOMINIO_BASE=localhost

# Esquema dos endereços públicos. Em produção é https.
ESQUEMA=http

# Entrega de eventos ao n8n. As duas juntas, ou nenhuma: sem elas os eventos
# ficam na fila. A autorização é o valor inteiro do cabeçalho.
# N8N_EVENTOS_URL=https://n8n.avilaops.com/webhook/cms-eventos
# N8N_EVENTOS_AUTORIZACAO=Bearer troque-por-um-segredo

# Token com que o n8n encerra eventos em /api/admin/eventos/<id>/encerrar.
# Não é o mesmo da entrega.
# N8N_TOKEN_DE_VOLTA=troque-por-outro-segredo

# Chave do IndexNow: de 8 a 128 letras, números ou hífens. Não é segredo: cada
# site a serve em /<chave>.txt. Sem ela, os buscadores não são avisados.
# INDEXNOW_CHAVE=

# Onde ficam as variantes de imagem, uma pasta por site.
DIRETORIO_DE_MIDIA=./var/midia
