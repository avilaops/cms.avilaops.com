# Copie para `.env`. O `.env` não é versionado.

# Banco. As consultas são conferidas contra ele na compilação; sem banco à
# mão, use SQLX_OFFLINE=true, que lê o diretório `.sqlx`.
DATABASE_URL=postgres://postgres@127.0.0.1:5549/cms_dev

# Porta em que o servidor escuta.
PORTA=3090

# Todo site nasce em <slug>.<DOMINIO_BASE>.
DOMINIO_BASE=localhost

# Esquema dos endereços públicos. Em produção é https.
ESQUEMA=http

# Onde ficam as variantes de imagem, uma pasta por site.
DIRETORIO_DE_MIDIA=./var/midia
